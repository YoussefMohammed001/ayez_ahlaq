    {
      "name": "Device token (FCM push)",
      "item": [
        {
          "name": "Register / re-point",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/device_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "device_token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-registration-token\",\n  \"platform\": \"ANDROID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Upserts — a token identifies one device. platform: ANDROID | IOS | WEB."
          }
        },
        {
          "name": "Unregister one",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/device_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "device_token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-registration-token\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unregister all (logout)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/device_token/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "device_token",
                "all"
              ]
            }
          }
        }
      ]
    },
    {
