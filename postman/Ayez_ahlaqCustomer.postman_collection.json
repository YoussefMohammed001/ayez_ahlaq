{
  "info": {
    "name": "Ayez Ahlaq — Customer (mobile app)",
    "description": "Every endpoint the customer app calls. Auth = phone + password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://gobeeeg.com/ayezAhlaqApi"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "shopId",
      "value": "1"
    },
    {
      "key": "barberId",
      "value": "1"
    },
    {
      "key": "serviceTypeId",
      "value": "1"
    },
    {
      "key": "haircutStyleId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "productId2",
      "value": "2"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "notificationId",
      "value": "1"
    },
    {
      "key": "transferAccountId",
      "value": "1"
    },
    {
      "key": "walletRequestId",
      "value": "1"
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "drinkId",
      "value": "1"
    },
    {
      "key": "inviteCode",
      "value": "ABCD234"
    },
    {
      "key": "date",
      "value": "2026-09-10"
    },
    {
      "key": "lat",
      "value": "30.0444"
    },
    {
      "key": "lng",
      "value": "31.2357"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"سمير\",\n  \"phoneNumber\": \"01555555555\",\n  \"password\": \"cust1234\",\n  \"email\": \"c@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "ALWAYS returns { activated:false, auth:null, otpTtlSeconds:300, devOtp } — NO token. Call 'Register - verify OTP' next. A verified live phone -> 409.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"01555555555\",\n  \"password\": \"cust1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Un-verified phone -> 400 'رقم هاتفك غير مؤكّد'. Blocked account -> 400.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.token) pm.collectionVariables.set('token', d.token);",
                  "if (d && d.auth && d.auth.token) pm.collectionVariables.set('token', d.auth.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/register/verifyOtp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register",
                "verifyOtp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01555555555\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "ALWAYS required — the customer register call returns NO token. Returns the full AuthResponse (the token).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.token) pm.collectionVariables.set('token', d.token);",
                  "if (d && d.auth && d.auth.token) pm.collectionVariables.set('token', d.auth.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/register/resendOtp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register",
                "resendOtp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01555555555\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Fresh 6-digit code (TTL 300s), attempt counter reset, previous code dead. 400 if there is no pending / un-verified signup for that number.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Forgot password - send code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "password",
                "forgot"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01555555555\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "{ expiresInSeconds, devOtp }. Barber: works for the owner AND a team member; no X-Client needed.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Forgot password - verify code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/password/verifyOtp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "password",
                "verifyOtp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01555555555\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "{ resetToken (opaque, TTL 600s), expiresInSeconds }.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.resetToken) pm.collectionVariables.set('resetToken', d.resetToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password - reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "password",
                "reset"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"newpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Third step. 400 on a bad / expired reset token.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Change password (logged in)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"cust1234\",\n  \"newPassword\": \"newpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "min 6 chars; wrong currentPassword -> 400. Barber: X-Client required."
          }
        }
      ]
    },
