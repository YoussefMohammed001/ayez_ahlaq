    {
      "name": "Haircut booking",
      "item": [
        {
          "name": "Free slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking/slots?shopId={{shopId}}&serviceTypeId={{serviceTypeId}}&date={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking",
                "slots"
              ],
              "query": [
                {
                  "key": "shopId",
                  "value": "{{shopId}}"
                },
                {
                  "key": "serviceTypeId",
                  "value": "{{serviceTypeId}}"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                }
              ]
            },
            "description": "{ date, serviceTypeId, perBarber:[{barberId,barberName,durationMinutes,slots}], anyBarberSlots }"
          }
        },
        {
          "name": "Book (auto-select or a barber)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": {{shopId}},\n  \"autoSelect\": true,\n  \"barberId\": null,\n  \"serviceTypeId\": {{serviceTypeId}},\n  \"haircutStyleId\": {{haircutStyleId}},\n  \"date\": \"{{date}}\",\n  \"slotTime\": \"14:30\",\n  \"paymentMethod\": \"CASH\",\n  \"note\": \"لو سمحت سريع\",\n  \"drinks\": [\n    {\n      \"drinkId\": \"{{drinkId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"addons\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PENDING; the shop confirms within the wait window (auto-accept or auto-cancel per the admin setting). autoSelect:true → least-busy free barber. `drinks` (optional) = picks from shop-detail drinks[], each { drinkId, quantity }. `addons` (optional) = storefront products, each { productId, quantity } (active + in stock, else 400). total = service price + Σ drinks + Σ add-ons; the view echoes addons[] (drinkId set for drink lines) with names + line totals. The barber can also add/adjust drinks in-queue via PUT /api/barber/booking/{id}/billing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.id) pm.collectionVariables.set('bookingId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking"
              ]
            }
          }
        },
        {
          "name": "Booking detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "Carries queuePosition, peopleAhead, ratedBarber, ratedShop."
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking/{{bookingId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking",
                "{{bookingId}}",
                "cancel"
