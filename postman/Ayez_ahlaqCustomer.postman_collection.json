        {
          "name": "Book (auto-select or a barber)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": {{shopId}},\n  \"autoSelect\": true,\n  \"barberId\": null,\n  \"serviceTypeId\": {{serviceTypeId}},\n  \"haircutStyleId\": {{haircutStyleId}},\n  \"date\": \"{{date}}\",\n  \"slotTime\": \"14:30\",\n  \"paymentMethod\": \"CASH\",\n  \"note\": \"لو سمحت سريع\",\n  \"addons\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PENDING; the shop must confirm within 30 min or it auto-cancels. autoSelect:true — least-busy free barber. total = service price + Σ add-ons.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var d = pm.response.json().data;",
                    "if (d && d.id) pm.collectionVariables.set('bookingId', d.id);"
                  ]
