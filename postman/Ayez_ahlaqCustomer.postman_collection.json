              ],
              "path": [
                "api",
                "customer",
                "notification"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "{ content[], page, size, totalElements, totalPages }. type routes the tap; referenceType+referenceId deep-link."
          }
