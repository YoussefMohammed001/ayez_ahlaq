                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "shop",
                "{{shopId}}",
                "storefront",
                "product",
                "{{productId}}",
                "image"
              ]
            }
          }
        },
        {
          "name": "Storefront category image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop/{{shopId}}/storefront/category/1/image",
