{
  "info": {
    "name": "Ayez Ahlaq — Customer (mobile app)",
    "description": "Every endpoint the customer app calls. Auth = phone + password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://gobeeeg.com/ayezAhlaqApi"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "shopId",
      "value": "1"
    },
    {
      "key": "barberId",
      "value": "1"
    },
    {
      "key": "serviceTypeId",
      "value": "1"
    },
    {
      "key": "haircutStyleId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "notificationId",
      "value": "1"
    },
    {
      "key": "inviteCode",
      "value": "ABCD234"
    },
    {
      "key": "date",
      "value": "2026-09-10"
    },
    {
      "key": "lat",
      "value": "30.0444"
    },
    {
      "key": "lng",
      "value": "31.2357"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"سمير\",\n  \"phoneNumber\": \"01555555555\",\n  \"password\": \"cust1234\",\n  \"email\": \"c@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"01555555555\",\n  \"password\": \"cust1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.token) pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Inbox (paged)",
          "request": {
            "method": "GET",
            "header": [],
