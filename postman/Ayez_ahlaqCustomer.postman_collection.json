    {
      "name": "Browse shops",
      "item": [
        {
          "name": "Shops — nearest first",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop?lat={{lat}}&lng={{lng}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "shop"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}"
                }
              ]
            },
            "description": "Each shop: distanceKm (null if no coords), favorite, sponsored. WITH lat/lng: if the customer falls inside an admin service zone → only that zone's shops, nearest first; else all shops nearest first. Sponsored shops are pinned to the very top (with sponsored=true) regardless of distance."
          }
        },
        {
          "name": "Shops — no location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "shop"
              ]
            },
            "description": "No lat/lng → ordered by rating desc, then most-visited (completed bookings) desc. Sponsored shops still pinned on top."
          }
        },
        {
          "name": "Shop detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop/{{shopId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "shop",
                "{{shopId}}"
              ]
            },
            "description": "{ shop, barbers[] (services, favorite, viaInvite), haircutStyles[], paymentMethods[], addons[], drinks[] }. drinks[] = { id, name, price } — the shop's DRINK MENU, the primary pick-list on the booking screen; send picks as `drinks` on POST /api/customer/booking. addons[] = storefront products (id, name, brand, categoryId, categoryName, price, stock) — the older buffet path, still sendable as `addons`."
          }
        },
        {
          "name": "Storefront of a shop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop/{{shopId}}/storefront",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "shop",
                "{{shopId}}",
                "storefront"
              ]
            },
            "description": "{ shopName, delivery, categories[], products[] } — barber-shop products only, never merchant."
          }
        },
        {
          "name": "Storefront product image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/shop/{{shopId}}/storefront/product/{{productId}}/image",
